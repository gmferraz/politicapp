{
  "expo": {
    "name": "Politicapp",
    "slug": "politicapp",
    "version": "1.0.0",
    "scheme": "politicapp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.politicapp"
    },
    "android": {
      "package": "br.com.politicapp",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#149246"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "17.0" },
          "android": {
            "minSdkVersion": 24,
            "extraProguardRules": "-keep class com.tencent.mmkv.** { *; }\n-keep class com.mrousavy.mmkv.** { *; }"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["pt-BR"],
            "android": ["pt-BR"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#FFFFFF",
          "dark": { "backgroundColor": "#000000" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
